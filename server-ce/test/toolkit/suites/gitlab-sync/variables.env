# GitLab Sync against services/gitlab-mock, which answers as the self-managed
# GitLab gitlab.example.com on the toolkit's network. Its bin/prepare fills in
# the OAuth client and the token cipher password.
GITLAB_SYNC_ENABLED=true
GITLAB_SYNC_URL=https://gitlab.example.com

# Trust the mock's throwaway CA, written by its bin/prepare
NODE_EXTRA_CA_CERTS=/var/lib/overleaf/certs/gitlab-mock-ca.pem
