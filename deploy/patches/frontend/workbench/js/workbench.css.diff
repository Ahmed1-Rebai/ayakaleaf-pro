--- workbench.css.orig	2026-10-15 10:09:50.889174685 +0000
+++ workbench.css	2026-10-15 10:11:48.806469104 +0000
@@ -708,3 +708,126 @@
 body {
   counter-reset: katexEqnNo mmlEqnNo;
 }
+
+/* LambdaTeX patch: saved conversations (components/conversation-list.tsx) */
+.workbench-panel-conversations-open .workbench-tab-content {
+  display: none;
+}
+
+.workbench-conversations {
+  display: flex;
+  flex: 1 1 auto;
+  flex-direction: column;
+  min-height: 0;
+  overflow-y: auto;
+  padding: 8px 10px 12px;
+}
+
+.workbench-conversations-header {
+  display: flex;
+  align-items: center;
+  justify-content: space-between;
+  gap: 8px;
+  padding: 2px 2px 10px;
+}
+
+.workbench-conversations-title {
+  font-size: 14px;
+  font-weight: 600;
+}
+
+.workbench-conversations-note {
+  padding: 12px 4px;
+  font-size: 13px;
+  color: var(--content-secondary);
+}
+
+.workbench-conversations-list {
+  display: flex;
+  flex-direction: column;
+  gap: 2px;
+  margin: 0;
+  padding: 0;
+  list-style: none;
+}
+
+.workbench-conversation {
+  display: flex;
+  align-items: center;
+  gap: 2px;
+  padding: 2px 4px;
+  border-radius: 8px;
+}
+
+.workbench-conversation:hover {
+  background: var(--bg-light-secondary, rgba(0, 0, 0, 0.04));
+}
+
+.workbench-conversation.active {
+  background: var(--bg-accent-03, rgba(37, 99, 235, 0.08));
+  box-shadow: inset 3px 0 0 var(--bg-accent-01, #2563eb);
+}
+
+.workbench-conversation-open {
+  display: flex;
+  flex: 1 1 auto;
+  flex-direction: column;
+  align-items: flex-start;
+  gap: 2px;
+  min-width: 0;
+  padding: 6px;
+  border: 0;
+  border-radius: 6px;
+  background: transparent;
+  color: inherit;
+  text-align: left;
+  cursor: pointer;
+}
+
+.workbench-conversation-name {
+  width: 100%;
+  overflow: hidden;
+  font-size: 13px;
+  font-weight: 500;
+  text-overflow: ellipsis;
+  white-space: nowrap;
+}
+
+.workbench-conversation-meta {
+  font-size: 11.5px;
+  color: var(--content-secondary);
+}
+
+.workbench-conversation .icon-button-small {
+  opacity: 0.55;
+  transition: opacity 0.15s;
+}
+
+.workbench-conversation:hover .icon-button-small,
+.workbench-conversation:focus-within .icon-button-small {
+  opacity: 1;
+}
+
+.workbench-conversation-rename {
+  margin: 4px;
+}
+
+.workbench-conversation-confirm {
+  display: flex;
+  flex: 1 1 auto;
+  flex-wrap: wrap;
+  align-items: center;
+  justify-content: space-between;
+  gap: 8px;
+  padding: 6px;
+  font-size: 13px;
+}
+
+.workbench-conversation-confirm-actions {
+  display: flex;
+  gap: 6px;
+}
+
+.rail-panel-header-button-subdued.active {
+  color: var(--bg-accent-01, #2563eb);
+}
