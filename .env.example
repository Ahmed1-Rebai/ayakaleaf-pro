# Ayakaleaf Pro / LambdaTeX settings. Placeholders only; NEVER commit real values.
# Copy to .env (repo root), fill in, then: chmod 600 .env
# .env is git-ignored and loaded into the app container by deploy/toolkit-override.example.yml.

# --- AI gateway ---
AI_ENABLED=true
AI_BASE_URL=http://10.110.150.21:30883/v1
AI_MODEL=palmfuture/Qwen3.6-35B-A3B-GPTQ-Int4
# Alternatives: groq/openai/gpt-oss-120b (text-only; Groq caps tokens per minute),
# Qwen/Qwen3.5-122B-A10B-GPTQ-Int4 (also at https://lambda-way.deslabcloud.com/v1)
AI_API_KEY=replace-with-your-gateway-key

# Optional
# AI_IMAGE_MODEL=
AI_MAX_STEPS=12
# AI_TOKEN_QUOTA=0
# AI_TOKEN_QUOTA_PERIOD=month
# AI_PROXY_URL=
# TAVILY_API_KEY=
# DOCS_MCP_URL=          # empty string disables the public GitBook docs search

# --- Admin account (applied by deploy/scripts/seed-admin.sh) ---
SEED_ADMIN_EMAIL=admin@example.org
SEED_ADMIN_PASSWORD=replace-with-a-strong-password

# --- Mail (SMTP relay, e.g. Brevo) ---
Email__Enabled=true
Email__Host=smtp-relay.example.com
Email__Port=587
Email__Username=replace-with-smtp-login
Email__Password=replace-with-smtp-key
Email__UseStartTls=true
Email__FromAddress=contact@example.org
Email__FromName=Example Research Lab

# Overleaf reads OVERLEAF_EMAIL_*; the values come from Email__* above.
# Mail is on while OVERLEAF_EMAIL_FROM_ADDRESS is set: comment it out to turn mail off.
OVERLEAF_EMAIL_FROM_ADDRESS="${Email__FromName} <${Email__FromAddress}>"
OVERLEAF_EMAIL_SMTP_HOST=${Email__Host}
OVERLEAF_EMAIL_SMTP_PORT=${Email__Port}
# Email__UseStartTls=true on 587: plain connection upgraded with STARTTLS, not implicit TLS
# (for port 465 use SECURE=true). Overleaf cannot *require* STARTTLS: it upgrades when offered.
OVERLEAF_EMAIL_SMTP_SECURE=false
OVERLEAF_EMAIL_SMTP_IGNORE_TLS=false
# Overleaf sends SMTP AUTH whenever these are defined; remove both for an open relay.
OVERLEAF_EMAIL_SMTP_USER=${Email__Username}
OVERLEAF_EMAIL_SMTP_PASS=${Email__Password}
# Contact address shown to people without an account (e.g. on /register)
OVERLEAF_ADMIN_EMAIL=${Email__FromAddress}

# --- Compiling ---
# The TeX engine is chosen automatically per compile; set to false to always use the
# project's Compiler setting.
# AUTO_COMPILER=true
