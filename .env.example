# Ayakaleaf Pro: AI gateway settings. Placeholders only; NEVER commit real values.
# Copy to .env (repo root), set AI_API_KEY, then: chmod 600 .env
# .env is git-ignored and loaded into the app container by deploy/docker-compose.override.yml.
AI_ENABLED=true
AI_BASE_URL=https://lambda-way.deslabcloud.com/v1
AI_MODEL=Qwen/Qwen3.5-122B-A10B-GPTQ-Int4
AI_API_KEY=replace-with-your-gateway-key

# Optional
# AI_IMAGE_MODEL=
# AI_MAX_STEPS=20
# AI_TOKEN_QUOTA=0
# AI_TOKEN_QUOTA_PERIOD=month
# AI_PROXY_URL=
# TAVILY_API_KEY=
# DOCS_MCP_URL=          # empty string disables the public GitBook docs search
