# Ayakaleaf Pro / LambdaTeX settings. Placeholders only; NEVER commit real values.
# Copy to .env (repo root), fill in, then: chmod 600 .env
# .env is git-ignored and loaded into the app container by deploy/toolkit-override.example.yml.

# --- AI gateway ---
AI_ENABLED=true
AI_BASE_URL=https://lambda-way.deslabcloud.com/v1
AI_MODEL=Qwen/Qwen3.5-122B-A10B-GPTQ-Int4
AI_API_KEY=replace-with-your-gateway-key

# Optional
# AI_IMAGE_MODEL=
# AI_MAX_STEPS=20
# AI_TOKEN_QUOTA=0
# AI_TOKEN_QUOTA_PERIOD=month
# AI_PROXY_URL=
# TAVILY_API_KEY=
# DOCS_MCP_URL=          # empty string disables the public GitBook docs search

# --- Admin account (applied by deploy/scripts/seed-admin.sh) ---
SEED_ADMIN_EMAIL=admin@example.org
SEED_ADMIN_PASSWORD=replace-with-a-strong-password

# --- Mail ---
EMAIL__ENABLED=true
EMAIL__HOST=host.docker.internal
EMAIL__PORT=25
EMAIL__USERNAME=
EMAIL__PASSWORD=
EMAIL__USE_STARTTLS=false
EMAIL__FROM_ADDRESS=contact@example.org
EMAIL__FROM_NAME=Example Research Lab
EMAIL__REPLY_TO=contact@example.org

# Overleaf reads OVERLEAF_EMAIL_*; the values come from EMAIL__* above.
# Mail is on while OVERLEAF_EMAIL_FROM_ADDRESS is set: comment it out to turn mail off.
OVERLEAF_EMAIL_FROM_ADDRESS="${EMAIL__FROM_NAME} <${EMAIL__FROM_ADDRESS}>"
OVERLEAF_EMAIL_REPLY_TO=${EMAIL__REPLY_TO}
OVERLEAF_EMAIL_SMTP_HOST=${EMAIL__HOST}
OVERLEAF_EMAIL_SMTP_PORT=${EMAIL__PORT}
OVERLEAF_EMAIL_SMTP_SECURE=false
# EMAIL__USE_STARTTLS=false: do not upgrade the connection with STARTTLS
OVERLEAF_EMAIL_SMTP_IGNORE_TLS=true
# Overleaf sends SMTP AUTH as soon as these are defined, even empty: uncomment only
# when the relay needs a login.
# OVERLEAF_EMAIL_SMTP_USER=${EMAIL__USERNAME}
# OVERLEAF_EMAIL_SMTP_PASS=${EMAIL__PASSWORD}
# Contact address shown to people without an account (e.g. on /register)
OVERLEAF_ADMIN_EMAIL=${EMAIL__REPLY_TO}
